#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: %s [run-id] [full|swarm]\n' "$(basename "$0")" >&2
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

run_id="${1:-$(date +%Y%m%d-%H%M%S)}"
lane="${2:-swarm}"
root=".agents/runtime/$run_id"

if [ "$lane" != "full" ] && [ "$lane" != "swarm" ]; then
  usage
  exit 2
fi

mkdir -p "$root/briefs" "$root/reports" "$root/review-packages"

if [ ! -e ".gitignore" ]; then
  printf '.agents/\n' > .gitignore
elif ! grep -qxF '.agents/' .gitignore; then
  printf '.agents/\n' >> .gitignore
fi

if [ ! -f "$root/.gitignore" ]; then
  printf '*\n!.gitignore\n' > "$root/.gitignore"
fi

if [ ! -f "$root/progress.md" ]; then
  cat > "$root/progress.md" <<MD
# $run_id Progress

State: running
Lane: $lane
Supervisor: <agent/app/model or owner>
Plan/Issue: <path or tracker link>

## Controller State

- Current objective:
- Integration branch/worktree:
- Concurrency limit:
- Stop condition:

## Task Board

| Task | Owner | State | Branch/Worktree | Report | Updated |
| --- | --- | --- | --- | --- | --- |
| none | none | none | none | none | none |

## Latest Transition

- output:
- lane:
- state:
- result:
- next:
- evidence:

## Event Log

- <time> | runtime created | $root
MD
fi

printf '%s\n' "$root"
