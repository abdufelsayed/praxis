#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: %s <runtime-dir> <task-id> [title] [plan-or-issue]\n' "$(basename "$0")" >&2
  printf '       %s <runtime-dir> <task-id> <plan-or-issue>\n' "$(basename "$0")" >&2
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

runtime_dir="${1:-}"
task_id="${2:-}"
title="${3:-$task_id}"
source_file="${4:-}"

if [ -z "$runtime_dir" ] || [ -z "$task_id" ]; then
  usage
  exit 2
fi

if [ -n "${3:-}" ] && [ -z "${4:-}" ] && [ -f "$3" ]; then
  title="$task_id"
  source_file="$3"
fi

if [ -n "$source_file" ] && [ ! -f "$source_file" ]; then
  printf 'task-brief: source file not found: %s\n' "$source_file" >&2
  exit 2
fi

mkdir -p "$runtime_dir/briefs"
brief="$runtime_dir/briefs/$task_id-brief.md"
source_tmp=""

if [ -n "$source_file" ]; then
  source_tmp="$(mktemp)"
  trap 'rm -f "$source_tmp"' EXIT

  task_num="${task_id#T}"
  task_num="${task_num#t}"
  if ! [[ "$task_num" =~ ^[0-9]+$ ]]; then
    task_num=""
  fi

  awk -v target="$task_id" -v n="$task_num" '
    function heading_level(line) {
      if (match(line, /^#+/)) return RLENGTH
      return 0
    }
    function esc_re(s) {
      gsub(/[][(){}.^$*+?|\\]/, "\\\\&", s)
      return s
    }
    function matches_target(line, lower, t) {
      if (line !~ /^#+[ \t]+/) return 0
      lower = tolower(line)
      t = tolower(target)
      if (lower ~ "(^|[^a-z0-9_-])" esc_re(t) "([^a-z0-9_-]|$)") return 1
      if (n != "" && lower ~ "^#+[ \t]+task[ \t]+" n "([^0-9]|$)") return 1
      if (n != "" && lower ~ "^#+[ \t]+t" n "([^0-9]|$)") return 1
      return 0
    }
    /^```/ { in_fence = !in_fence }
    !in_fence && heading_level($0) > 0 {
      level = heading_level($0)
      if (capture && level <= start_level) exit
      if (!capture && matches_target($0)) {
        capture = 1
        start_level = level
      }
    }
    capture { print }
  ' "$source_file" > "$source_tmp"

  if [ ! -s "$source_tmp" ]; then
    printf 'task-brief: task %s not found in %s\n' "$task_id" "$source_file" >&2
    printf 'task-brief: expected a heading like "### %s" or "### Task %s"\n' "$task_id" "${task_num:-<number>}" >&2
    exit 3
  fi
fi

cat > "$brief" <<MD
# $title Brief

Task ID: $task_id
Status: ready
Parent: ${source_file:-<plan/issue/spec path or tracker link>}
Supervisor: <owner>
Report Path: $runtime_dir/reports/$task_id-report.md

## Agent Control

- Required process: implement this task only; report before any broader change.
- Execution mode: worker
- Review gate: task review by supervisor or reviewer before acceptance.
- Verification gate: run named checks or report exactly why they could not run.

## Source Task

MD

if [ -n "$source_tmp" ]; then
  cat "$source_tmp" >> "$brief"
else
  cat >> "$brief" <<'MD'
<exact task text extracted from the plan, issue, or spec>
MD
fi

cat >> "$brief" <<MD

## Goal

<one bounded outcome>

## Scope

In:
- <files, behavior, or area>

Out:
- <explicit non-goal>

## Context

- <facts, links, decisions, or repo rules the worker needs>

## Acceptance Criteria

- AC-1: <checkable outcome>

## Files And Ownership

- Create:
- Modify:
- Do not touch:

## Allowed Tools

- <commands, scripts, MCP tools, or "repo-default tools only">

## Checks

- CHK-1: <command or manual check> -> <expected signal>

## Stop Rules

- Stop and report NEEDS_CONTEXT when hidden user intent or credentials are required.
- Stop and report BLOCKED before destructive, force, production, migration, or broad rewrite steps not named here.
- Stop and report BLOCKED if another worker owns the same file or contract and the brief does not define conflict resolution.
- Stop and report BLOCKED if satisfying the task requires files, behavior, or dependencies outside scope.

## Report Required

- Status: DONE | DONE_WITH_CONCERNS | NEEDS_CONTEXT | BLOCKED | FAILED
- Changed files
- Acceptance criteria satisfied
- Checks run and results
- Anything not verified
- Review focus or remaining risk

## Report Schema

\`\`\`text
Task ID: $task_id
Status: DONE | DONE_WITH_CONCERNS | NEEDS_CONTEXT | BLOCKED | FAILED
Changed files:
Acceptance:
Checks:
Unverified:
Risks:
Next:
\`\`\`
MD

printf '%s\n' "$brief"
