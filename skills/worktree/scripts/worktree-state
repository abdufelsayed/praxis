#!/usr/bin/env bash
# Report enough git state to distinguish a normal checkout, linked worktree,
# and submodule without changing repository state.
#
# Usage: worktree-state [DIRECTORY]
set -euo pipefail

directory=${1:-.}

root=$(git -C "$directory" rev-parse --show-toplevel)
git_dir=$(git -C "$directory" rev-parse --path-format=absolute --git-dir)
common_dir=$(git -C "$directory" rev-parse --path-format=absolute --git-common-dir)
branch=$(git -C "$directory" branch --show-current)
superproject=$(git -C "$directory" rev-parse --show-superproject-working-tree 2>/dev/null || true)

if [[ -n "$superproject" ]]; then
  kind=submodule
elif [[ "$git_dir" != "$common_dir" ]]; then
  kind=linked-worktree
else
  kind=normal-checkout
fi

printf 'kind=%s\n' "$kind"
printf 'root=%s\n' "$root"
printf 'branch=%s\n' "${branch:-DETACHED}"
printf 'git_dir=%s\n' "$git_dir"
printf 'common_dir=%s\n' "$common_dir"
printf 'superproject=%s\n' "${superproject:-NONE}"
