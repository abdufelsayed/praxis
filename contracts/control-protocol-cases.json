{
  "protocol": "control-protocol.schema.json",
  "cases": [
    {
      "id": "read-only-research-allowed",
      "rule": "Read-only research inside the inquiry effect policy is eligible.",
      "input": {
        "inquiry": {
          "id": "inq-research",
          "revision": 1,
          "question": "What does the ecosystem already provide?",
          "position": "understand",
          "judgment_owner": "requester",
          "posture": "paired discovery",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["ecosystem evidence"],
          "effect_policy": { "allow": ["read", "research"], "deny": ["mutate_source", "git"] },
          "persistence_policy": { "research-findings": "automatic" },
          "authority_references": [],
          "close_when": "The ecosystem boundary is judgeable."
        },
        "action": {
          "operation": "inspect",
          "target": "upstream source",
          "reads": true,
          "mutates": false,
          "persists": false,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "evidence",
          "expected_result": "Current source evidence"
        },
        "records": [],
        "authorities": []
      },
      "expected_decision": { "decision": "allow", "reasons": [] }
    },
    {
      "id": "research-persistence-automatic",
      "rule": "Substantial research may update its bounded evidence record automatically.",
      "input": {
        "inquiry": {
          "id": "inq-research",
          "revision": 2,
          "question": "What does the ecosystem already provide?",
          "position": "understand",
          "judgment_owner": "requester",
          "posture": "paired discovery",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["cross-source synthesis"],
          "effect_policy": { "allow": ["read", "research", "persist_evidence"], "deny": ["mutate_source"] },
          "persistence_policy": { "research-findings": "automatic" },
          "authority_references": [],
          "close_when": "The source talking points and learnings are auditable."
        },
        "action": {
          "operation": "update",
          "target": "research/ecosystem.md",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "evidence",
          "record_kind": "research-findings",
          "authority_source": "inq-research:persistence-policy",
          "expected_result": "Updated source talking points and research learnings"
        },
        "records": [],
        "authorities": []
      },
      "expected_decision": { "decision": "allow", "reasons": [] }
    },
    {
      "id": "governing-persistence-disabled",
      "rule": "A governing record cannot be written when its persistence policy is prohibited.",
      "input": {
        "inquiry": {
          "id": "inq-discuss",
          "revision": 1,
          "question": "What should the package mean?",
          "position": "understand",
          "judgment_owner": "requester",
          "posture": "discussion",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["product judgment"],
          "effect_policy": { "allow": ["read"], "deny": ["persist_governing_record", "mutate_source"] },
          "persistence_policy": { "requirements": "prohibited" },
          "authority_references": [],
          "close_when": "The requester accepts the meaning."
        },
        "action": {
          "operation": "update",
          "target": "requirements.md",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "governing_record",
          "record_kind": "requirements",
          "expected_result": "Revised Requirements"
        },
        "records": [],
        "authorities": [],
        "latest_direction": {
          "summary": "Discuss only; do not edit.",
          "narrows_effects": ["persist_governing_record"],
          "narrows_persistence": ["requirements"]
        }
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["The active inquiry and latest direction prohibit governing-record persistence."]
      }
    },
    {
      "id": "source-mutation-needs-authority",
      "rule": "Source mutation is blocked without current implementation authority.",
      "input": {
        "inquiry": {
          "id": "inq-delivery",
          "revision": 1,
          "question": "Can the accepted result be implemented?",
          "position": "deliver",
          "judgment_owner": "requester",
          "posture": "bounded delivery",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": [],
          "effect_policy": { "allow": ["read"], "deny": ["mutate_source"] },
          "persistence_policy": {},
          "authority_references": [],
          "close_when": "The result is proved or safely blocked."
        },
        "action": {
          "operation": "modify",
          "target": "src/example.ml",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "source",
          "expected_result": "Implemented behavior"
        },
        "records": [],
        "authorities": []
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["No granted authority covers source mutation at this target."]
      }
    },
    {
      "id": "implementation-authority-does-not-authorize-commit",
      "rule": "Implementation authority alone does not authorize a Git commit.",
      "input": {
        "inquiry": {
          "id": "inq-delivery",
          "revision": 2,
          "question": "Can the accepted result be implemented?",
          "position": "deliver",
          "judgment_owner": "requester",
          "posture": "bounded delivery",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": [],
          "effect_policy": { "allow": ["read", "mutate_source"], "deny": ["git"] },
          "persistence_policy": {},
          "authority_references": ["auth-implementation"],
          "close_when": "The result is proved or safely blocked."
        },
        "action": {
          "operation": "commit",
          "target": "current repository index",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "git",
          "authority_source": "auth-implementation",
          "expected_result": "New commit"
        },
        "records": [],
        "authorities": [
          {
            "id": "auth-implementation",
            "state": "granted",
            "scope": "modify src/example.ml",
            "source": "implement the approved Plan"
          }
        ]
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["The granted implementation authority does not cover Git commit effects."]
      }
    },
    {
      "id": "stale-dependency-blocks-action",
      "rule": "An affected action is blocked when its governing record is stale.",
      "input": {
        "inquiry": {
          "id": "inq-delivery",
          "revision": 3,
          "question": "What survives changed product meaning?",
          "position": "learn_return",
          "judgment_owner": "requester",
          "posture": "causal return",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["requirement revision"],
          "effect_policy": { "allow": ["read"], "deny": ["mutate_source"] },
          "persistence_policy": {},
          "authority_references": ["auth-plan"],
          "close_when": "The causal requirement is judged."
        },
        "action": {
          "operation": "modify",
          "target": "src/error.ml",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "source",
          "governing_records": ["requirements-package"],
          "authority_source": "auth-plan",
          "expected_result": "Continue affected implementation"
        },
        "records": [
          {
            "kind": "requirements",
            "id": "requirements-package",
            "revision": 3,
            "meaning_state": "stale",
            "governing": [],
            "gates": []
          }
        ],
        "authorities": [
          {
            "id": "auth-plan",
            "state": "withdrawn",
            "scope": "implement error handling",
            "source": "approved Plan",
            "record_id": "plan-error",
            "record_revision": 2
          }
        ]
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["Affected governing meaning is stale and Plan authority is withdrawn."],
        "authority_id": "auth-plan",
        "authority_after": "withdrawn"
      }
    },
    {
      "id": "withdrawn-authority-blocks-mutation",
      "rule": "Withdrawn authority cannot authorize an effect.",
      "input": {
        "inquiry": {
          "id": "inq-return",
          "revision": 1,
          "question": "Which work remains eligible?",
          "position": "learn_return",
          "judgment_owner": "requester",
          "posture": "causal return",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["causal correction"],
          "effect_policy": { "allow": ["read"], "deny": ["mutate_source"] },
          "persistence_policy": {},
          "authority_references": ["auth-withdrawn"],
          "close_when": "Fresh authority is established or the work stops."
        },
        "action": {
          "operation": "modify",
          "target": "src/affected.ml",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "source",
          "authority_source": "auth-withdrawn",
          "expected_result": "Continue mutation"
        },
        "records": [],
        "authorities": [
          {
            "id": "auth-withdrawn",
            "state": "withdrawn",
            "scope": "modify src/affected.ml",
            "source": "invalidated Plan"
          }
        ]
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["The named authority is withdrawn."],
        "authority_id": "auth-withdrawn",
        "authority_after": "withdrawn"
      }
    },
    {
      "id": "independent-read-survives-invalidation",
      "rule": "Independent read-only work may continue after selective invalidation.",
      "input": {
        "inquiry": {
          "id": "inq-independent",
          "revision": 1,
          "question": "Does an independent dependency satisfy its contract?",
          "position": "understand",
          "judgment_owner": "requester",
          "posture": "read-only investigation",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["independent dependency behavior"],
          "effect_policy": { "allow": ["read", "research"], "deny": ["mutate_source"] },
          "persistence_policy": {},
          "authority_references": [],
          "close_when": "The independent claim is answered."
        },
        "action": {
          "operation": "inspect",
          "target": "independent dependency source",
          "reads": true,
          "mutates": false,
          "persists": false,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "evidence",
          "expected_result": "Independent evidence"
        },
        "records": [
          {
            "kind": "requirements",
            "id": "requirements-unrelated",
            "revision": 4,
            "meaning_state": "accepted",
            "governing": [],
            "gates": [],
            "challenge": {
              "state": "open",
              "evidence": ["A new probe challenges an unrelated requirement."],
              "proposed_consequence": "Revisit only the unrelated requirement."
            }
          }
        ],
        "authorities": []
      },
      "expected_decision": { "decision": "allow", "reasons": [] }
    },
    {
      "id": "challenged-dependency-blocks-mutation",
      "rule": "An open challenge blocks mutation that depends on the challenged meaning.",
      "input": {
        "inquiry": {
          "id": "inq-challenge",
          "revision": 1,
          "question": "What changes after the portability premise is challenged?",
          "position": "learn_return",
          "judgment_owner": "requester",
          "posture": "selective recursive reconciliation",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["portability consequence judgment"],
          "effect_policy": { "allow": ["read", "mutate_source"], "deny": [] },
          "persistence_policy": {},
          "authority_references": ["auth-challenged"],
          "close_when": "The requester judges the challenge and affected gates are current."
        },
        "action": {
          "operation": "modify",
          "target": "src/runtime.ml",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "source",
          "governing_records": ["requirements-portability"],
          "authority_source": "auth-challenged",
          "expected_result": "Continue implementation that depends on portability"
        },
        "records": [
          {
            "kind": "requirements",
            "id": "requirements-portability",
            "revision": 2,
            "meaning_state": "accepted",
            "governing": [],
            "gates": [],
            "challenge": {
              "state": "open",
              "evidence": ["The selected dependency requires a runtime."],
              "proposed_consequence": "Revise the portable-core boundary.",
              "impact": {
                "challenged_truth": { "kind": "requirements", "id": "requirements-portability", "revision": 2 },
                "decisive_evidence": ["dependency source"],
                "affected_descendants": [
                  { "kind": "plan", "id": "plan-runtime", "revision": 1 }
                ],
                "unaffected_truth": [
                  { "kind": "requirements", "id": "requirements-errors", "revision": 1 }
                ],
                "suspended_authorities": ["auth-challenged"],
                "needed_judgment": "Retain or revise the portable-core boundary."
              }
            }
          }
        ],
        "authorities": [
          {
            "id": "auth-challenged",
            "state": "granted",
            "scope": "modify src/runtime.ml",
            "source": "current implementation boundary"
          }
        ]
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["The action depends on accepted meaning with an unresolved challenge."]
      }
    },
    {
      "id": "meaningful-transition-needs-selection",
      "rule": "A meaningful transition is blocked until requester selection is present.",
      "input": {
        "inquiry": {
          "id": "inq-shape",
          "revision": 1,
          "question": "How should accepted meaning become judgeable work?",
          "position": "accept_meaning",
          "judgment_owner": "requester",
          "posture": "paired shaping",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["working-form route selection"],
          "effect_policy": { "allow": ["read"], "deny": ["persist_governing_record"] },
          "persistence_policy": { "issue": "prohibited", "evolution-map": "prohibited" },
          "authority_references": [],
          "close_when": "The requester selects the working-form transition."
        },
        "action": {
          "operation": "advance_position",
          "target": "shape",
          "reads": false,
          "mutates": false,
          "persists": false,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "governing_record",
          "expected_result": "Begin shaping work"
        },
        "records": [],
        "authorities": []
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["The meaningful lifecycle transition still requires requester selection."]
      }
    },
    {
      "id": "latest-direction-narrows-persistence",
      "rule": "The latest direction may immediately narrow earlier persistence policy.",
      "input": {
        "inquiry": {
          "id": "inq-research",
          "revision": 3,
          "question": "What should be retained from the research?",
          "position": "understand",
          "judgment_owner": "requester",
          "posture": "paused discussion",
          "accepted_context": [],
          "provisional_context": [],
          "unresolved_conditions": ["retention judgment"],
          "effect_policy": { "allow": ["read", "persist_evidence"], "deny": [] },
          "persistence_policy": { "research-findings": "automatic" },
          "authority_references": [],
          "close_when": "The requester restores or changes the persistence boundary."
        },
        "action": {
          "operation": "update",
          "target": "research/ecosystem.md",
          "reads": true,
          "mutates": true,
          "persists": true,
          "external": false,
          "destructive": false,
          "reversible": true,
          "surface": "evidence",
          "record_kind": "research-findings",
          "authority_source": "inq-research:persistence-policy",
          "expected_result": "Updated research record"
        },
        "records": [],
        "authorities": [],
        "latest_direction": {
          "summary": "Pause and do not write anything.",
          "narrows_effects": ["persist_evidence"],
          "narrows_persistence": ["research-findings"]
        }
      },
      "expected_decision": {
        "decision": "block",
        "reasons": ["The latest direction disables research persistence despite the earlier automatic policy."]
      }
    }
  ]
}
