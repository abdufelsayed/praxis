{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdufelsayed/dotfiles/praxis/control-protocol.schema.json",
  "title": "Praxis host-neutral inquiry and effect control protocol",
  "type": "object",
  "required": ["inquiry", "action", "records", "authorities"],
  "additionalProperties": false,
  "properties": {
    "inquiry": { "$ref": "#/$defs/inquiry" },
    "action": { "$ref": "#/$defs/action" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record_projection" }
    },
    "authorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority_projection" }
    },
    "latest_direction": { "$ref": "#/$defs/latest_direction" }
  },
  "$defs": {
    "revision": { "type": "integer", "minimum": 1 },
    "context_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "effect_policy": {
      "type": "object",
      "required": ["allow", "deny"],
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/effect_name" }
        },
        "deny": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/effect_name" }
        }
      }
    },
    "effect_name": {
      "enum": [
        "read",
        "research",
        "delegate",
        "persist_evidence",
        "persist_governing_record",
        "mutate_source",
        "git",
        "external_system",
        "destructive"
      ]
    },
    "persistence_mode": {
      "enum": ["automatic", "topic_closeout", "gate_only", "explicit", "prohibited"]
    },
    "inquiry": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "question",
        "position",
        "judgment_owner",
        "posture",
        "accepted_context",
        "provisional_context",
        "unresolved_conditions",
        "effect_policy",
        "persistence_policy",
        "authority_references",
        "close_when"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "question": { "type": "string", "minLength": 1 },
        "position": {
          "enum": ["understand", "accept_meaning", "shape", "deliver", "learn_return"]
        },
        "judgment_owner": { "type": "string", "minLength": 1 },
        "posture": { "type": "string", "minLength": 1 },
        "accepted_context": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "provisional_context": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "unresolved_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "effect_policy": { "$ref": "#/$defs/effect_policy" },
        "persistence_policy": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/persistence_mode" }
        },
        "authority_references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "close_when": { "type": "string", "minLength": 1 },
        "reframed_from": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "operation",
        "target",
        "reads",
        "mutates",
        "persists",
        "external",
        "destructive",
        "reversible",
        "surface",
        "expected_result"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "reads": { "type": "boolean" },
        "mutates": { "type": "boolean" },
        "persists": { "type": "boolean" },
        "external": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "surface": {
          "enum": ["evidence", "governing_record", "source", "git", "external_system"]
        },
        "record_kind": { "type": "string", "minLength": 1 },
        "governing_records": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_source": { "type": "string", "minLength": 1 },
        "expected_result": { "type": "string", "minLength": 1 }
      }
    },
    "learning": {
      "type": "object",
      "required": ["observation", "interpretation", "causal_owner"],
      "additionalProperties": false,
      "properties": {
        "target_or_attempt": { "type": "string", "minLength": 1 },
        "evaluator_context": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "interpretation": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["preference", "evidence", "critique", "verification", "approval", "acceptance"]
        },
        "decisive_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affected_truth": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "still_valid_truth": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "proposed_consequence": { "type": "string", "minLength": 1 },
        "uncertainty_or_disagreement": { "type": "string", "minLength": 1 },
        "needed_judgment": { "type": "string", "minLength": 1 },
        "impact": { "$ref": "#/$defs/impact_map" },
        "causal_owner": { "type": "string", "minLength": 1 }
      }
    },
    "impact_map": {
      "type": "object",
      "required": [
        "challenged_truth",
        "decisive_evidence",
        "affected_descendants",
        "unaffected_truth",
        "suspended_authorities",
        "needed_judgment"
      ],
      "additionalProperties": false,
      "properties": {
        "challenged_truth": { "$ref": "#/$defs/context_ref" },
        "decisive_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affected_descendants": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "unaffected_truth": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "suspended_authorities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "needed_judgment": { "type": "string", "minLength": 1 }
      }
    },
    "gate_projection": {
      "type": "object",
      "required": ["name", "state"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "enum": ["pending", "approved"] },
        "content_revision": { "$ref": "#/$defs/revision" },
        "target_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "accepted_reference": { "type": "string", "minLength": 1 }
      }
    },
    "record_projection": {
      "type": "object",
      "required": ["kind", "id", "revision", "meaning_state", "governing", "gates"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "meaning_state": {
          "enum": ["provisional", "pending_gate", "accepted", "stale", "superseded"]
        },
        "governing": {
          "type": "array",
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate_projection" }
        },
        "challenge": { "$ref": "#/$defs/challenge_projection" }
      }
    },
    "challenge_projection": {
      "type": "object",
      "required": ["state", "evidence", "proposed_consequence"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["open", "resolved"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proposed_consequence": { "type": "string", "minLength": 1 },
        "impact": { "$ref": "#/$defs/impact_map" }
      }
    },
    "authority_projection": {
      "type": "object",
      "required": ["id", "state", "scope", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["absent", "awaiting", "granted", "withdrawn", "exhausted"] },
        "scope": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "record_revision": { "$ref": "#/$defs/revision" }
      }
    },
    "latest_direction": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "narrows_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect_name" }
        },
        "narrows_persistence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guard_decision": {
      "type": "object",
      "required": ["decision", "reasons"],
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["allow", "block"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_after": {
          "enum": ["absent", "awaiting", "granted", "withdrawn", "exhausted"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "block" } } },
          "then": { "properties": { "reasons": { "minItems": 1 } } }
        }
      ]
    }
  }
}
